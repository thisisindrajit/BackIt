# BackIt API — copy to .env and adjust. Never commit real secrets.
ENVIRONMENT=development
# Shared Postgres (auth + app data). DB_SERVER is host or host:port.
DB_SERVER=localhost:5432
DB_USERNAME=indrajit
DB_PASSWORD=
DB_NAME=backit
CORS_ORIGINS=http://localhost:3000
WEB_BASE_URL=http://localhost:3000

# Better Auth (Next.js) JWT verification
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
AUTH_ISSUER=http://localhost:3000
# AUTH_AUDIENCE defaults to AUTH_ISSUER
# AUTH_AUDIENCE=
AUTH_ALGORITHMS=EdDSA,ES256,RS256

# Required outside development (encrypts webhook secrets, derives public ledger refs)
APP_ENCRYPTION_KEY=

# PayPal: "mock" (default, fully local) or "sandbox" (api-m.sandbox.paypal.com only)
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PARTNER_MERCHANT_ID=
PAYPAL_BN_CODE=

# OpenRouter (optional; template fallback when unset or on any failure)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Business rules
PLATFORM_FEE_BPS=800
HOLD_DAYS=30
PAYOUT_MINIMUM_CENTS=100
SANDBOX_PAYOUT_BUDGET_CENTS=100000
